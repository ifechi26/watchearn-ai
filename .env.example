# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server Configuration
FIREBASE_SERVICE_ACCOUNT_KEY=path_to_service_account_key.json
NODE_ENV=development
PORT=3000
VITE_API_URL=http://localhost:3000

# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Payment Provider (Paystack/Flutterwave)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=your_paystack_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_key

# Google Ads / Advertising
GOOGLE_AD_MANAGER_NETWORK_CODE=your_network_code
GOOGLE_ADS_CUSTOMER_ID=your_customer_id
GOOGLE_ADS_API_KEY=your_google_ads_api_key

# Admin
ADMIN_EMAIL=admin@watchearn.ai

# Email Service (optional)
SENDGRID_API_KEY=your_sendgrid_key

# Analytics
GOOGLE_ANALYTICS_ID=your_analytics_id
