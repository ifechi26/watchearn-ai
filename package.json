{
  "name": "watchearn-ai",
  "version": "1.0.0",
  "description": "WatchEarn AI - Video discovery and creator rewards platform",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "firebase": "^10.7.0",
    "axios": "^1.6.2",
    "lucide-react": "^0.294.0",
    "zustand": "^4.4.1",
    "tailwindcss": "^3.3.6",
    "framer-motion": "^10.16.16",
    "chart.js": "^4.4.0",
    "react-chartjs-2": "^5.2.0",
    "swiper": "^11.0.3",
    "react-swiper": "^10.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.0.0",
    "@google/generative-ai": "^0.3.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.8",
    "typescript": "^5.3.3",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32"
  }
